# Ambil connection string PostgreSQL dari Neon atau integrasi Storage Vercel.
# Jangan masukkan connection string ke variabel NEXT_PUBLIC_*.
DATABASE_URL=

# Mode contoh selalu tersedia saat npm run dev.
# Aktifkan hanya jika ingin menyediakan /demo pada deployment production.
ENABLE_DEMO=false

# Opsional: IP LAN komputer jika menguji dari HP dengan server development.
# Pisahkan beberapa IP dengan koma. Contoh: 192.168.1.5
DEV_ALLOWED_ORIGINS=
